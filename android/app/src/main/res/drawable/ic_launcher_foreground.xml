<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground adaptive icon ArTunning Monitor (NomadKit) — konsep "Gauge RS".
  Canvas 108dp; konten aman di lingkaran 66dp tengah (safe area).
  Berlapis: piringan krem + ring Outline-Warm, 8 tick (3 atas Warning, 5 Ocean),
  jarum RPM Ocean menyapu diagonal di belakang monogram RS, hub Forest di tengah.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Piringan krem (Background token) -->
    <path
        android:fillColor="#FFFDF7"
        android:pathData="M54,54m-30,0a30,30 0 1,1 60,0a30,30 0 1,1 -60,0" />

    <!-- Ring outline hangat di tepi piringan -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#E4DCCF"
        android:strokeWidth="1.6"
        android:pathData="M54,54m-30,0a30,30 0 1,1 60,0a30,30 0 1,1 -60,0" />

    <!-- Tick atas (Warning/Amber) — zona "rev" -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#CA8A04"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M54,25.5V28.5 M72,36L74.2,33.8 M36,36L33.8,33.8" />

    <!-- Tick sisanya (Ocean) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#0891B2"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M79.5,54H76.5 M72,72L74.2,74.2 M54,79.5V82.5 M36,72L33.8,74.2 M28.5,54H25.5" />

    <!-- Jarum RPM (Ocean) — tapered, menyapu dari kiri-bawah ke kanan-atas, DI BELAKANG huruf -->
    <path
        android:fillColor="#0891B2"
        android:pathData="M33.88,69.88 L68.82,37.48 L72.5,35.5 L70.52,39.18 L38.12,74.12 Z" />

    <!-- Huruf R (Secondary/Ocean) monoline -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#0891B2"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M41,71 V37 H49 A9,9 0 0 1 49,55 H42 M47.5,55 L57,71" />

    <!-- Huruf S (Tertiary/Forest) monoline, sedikit menumpuk di kaki R -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#166534"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M71,44.5 C69.5,40 66.5,37.5 62.5,37.5 C57,37.5 53.5,41 53.5,45.5 C53.5,54.5 65,50.5 65,57.5 C65,61.5 62,64.5 57.5,64.5 C53.5,64.5 50.5,62 49.5,58" />

    <!-- Hub jarum (Forest) di titik tengah, di atas semua layer -->
    <path
        android:fillColor="#166534"
        android:pathData="M54,54m-3.5,0a3.5,3.5 0 1,1 7,0a3.5,3.5 0 1,1 -7,0" />
</vector>
