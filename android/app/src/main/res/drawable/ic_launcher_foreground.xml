<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground adaptive icon ArTunning Monitor (NomadKit) — konsep "Speedometer RPM".
  Canvas 108dp; konten aman di lingkaran 66dp tengah (safe area).
  Dial krem + ring Outline-Warm, 11 tick skala 240 derajat (3 merah Amber = redline),
  jarum RPM Ocean dengan counterweight, as Forest di pusat.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Dial krem (Background token) -->
    <path
        android:fillColor="#FFFDF7"
        android:pathData="M54,54m-30,0a30,30 0 1,1 60,0a30,30 0 1,1 -60,0" />

    <!-- Ring outline hangat di tepi dial -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#E4DCCF"
        android:strokeWidth="1.6"
        android:pathData="M54,54m-30,0a30,30 0 1,1 60,0a30,30 0 1,1 -60,0" />

    <!-- Tick skala (Ocean) — 8 tick, celah 90 derajat di bawah -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#0891B2"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M43.5,72.19L40.5,77.38 M35.81,64.5L30.62,67.5 M33,54H27 M35.81,43.5L30.62,40.5 M43.5,35.81L40.5,30.62 M54,33V27 M64.5,35.81L67.5,30.62 M72.19,43.5L77.38,40.5" />

    <!-- Zona redline (Warning/Amber) — 3 tick kanan-bawah -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#CA8A04"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M75,54H81 M72.19,64.5L77.38,67.5 M64.5,72.19L67.5,77.38" />

    <!-- Counterweight jarum (Ocean) -->
    <path
        android:fillColor="#0891B2"
        android:pathData="M53.79,51.09 L47.45,58.59 L56.67,55.19 Z" />

    <!-- Jarum RPM (Ocean) — tapered, menyapu ke kanan-atas (posisi live) -->
    <path
        android:fillColor="#0891B2"
        android:pathData="M54.74,49.82 L74.48,39.65 L58.18,54.74 Z" />

    <!-- As jarum (Forest) di pusat -->
    <path
        android:fillColor="#166534"
        android:pathData="M54,54m-4.5,0a4.5,4.5 0 1,1 9,0a4.5,4.5 0 1,1 -9,0" />
</vector>
